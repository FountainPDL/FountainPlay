<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <View
        android:id="@+id/lock_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/lock_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp">

        <TextClock
            android:id="@+id/tc_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="?attr/colorOnSurface"
            android:textSize="92sp" />

        <TextClock
            android:id="@+id/tc_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, MMM d"
            android:format24Hour="EEE, MMM d"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tv_lock_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_lock_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <FrameLayout
            android:id="@+id/art_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginVertical="12dp">

            <ImageView
                android:id="@+id/iv_vinyl"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="top|center_horizontal"
                android:src="@drawable/bg_vinyl" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_lock_art"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="bottom|center_horizontal"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_art_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.FP.Medium" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/controls_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:background="@drawable/bg_lock_controls">
            <LinearLayout
                android:id="@+id/lock_repeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingVertical="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Repeat"
                android:tooltipText="Repeat">
                <ImageView
                    android:id="@+id/iv_lock_repeat"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_repeat"
                    app:tint="?attr/colorOnSurface" />
                <TextView
                    android:id="@+id/tv_lock_repeat"
                    style="@style/FP.ActionLabel"
                    android:text="Repeat" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/lock_prev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingVertical="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Previous"
                android:tooltipText="Previous">
                <ImageView
                    android:id="@+id/iv_lock_prev"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="?attr/colorOnSurface" />
                <TextView
                    android:id="@+id/tv_lock_prev"
                    style="@style/FP.ActionLabel"
                    android:text="Previous" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/lock_play"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingVertical="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Pause"
                android:tooltipText="Pause">
                <ImageView
                    android:id="@+id/iv_lock_play"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_pause"
                    app:tint="?attr/colorOnSurface" />
                <TextView
                    android:id="@+id/tv_lock_play"
                    style="@style/FP.ActionLabel"
                    android:text="Pause" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/lock_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingVertical="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Next"
                android:tooltipText="Next">
                <ImageView
                    android:id="@+id/iv_lock_next"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_skip_next"
                    app:tint="?attr/colorOnSurface" />
                <TextView
                    android:id="@+id/tv_lock_next"
                    style="@style/FP.ActionLabel"
                    android:text="Next" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/lock_fav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingVertical="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Like"
                android:tooltipText="Like">
                <ImageView
                    android:id="@+id/iv_lock_fav"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_favorite_border"
                    app:tint="?attr/colorOnSurface" />
                <TextView
                    android:id="@+id/tv_lock_fav"
                    style="@style/FP.ActionLabel"
                    android:text="Like" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_slide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="36dp"
            android:paddingHorizontal="28dp"
            android:paddingVertical="12dp"
            android:text="Slide to unlock  ››"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_lock_close"
        style="@style/Widget.Material3.Button.TextButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="8dp"
        android:text="Close preview"
        android:visibility="gone"
        app:icon="@drawable/ic_close" />
</FrameLayout>
