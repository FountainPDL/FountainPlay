<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:use_controller="false" />

    <!-- Always-present gesture surface (taps, swipes, double-tap) -->
    <View
        android:id="@+id/touch_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Controls; not clickable itself so empty areas pass touches to the gesture surface -->
    <LinearLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/fpScrim">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">
            <LinearLayout
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back"
                android:tooltipText="Back">
                <ImageView
                    android:id="@+id/btn_back_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="?attr/fpOnScrim" />
                <TextView
                    android:id="@+id/btn_back_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Back"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/fpOnScrim"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_video_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="8dp"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/fpOnScrim"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
            <LinearLayout
                android:id="@+id/btn_pip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="PiP"
                android:tooltipText="PiP">
                <ImageView
                    android:id="@+id/btn_pip_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_pip"
                    app:tint="?attr/fpOnScrim" />
                <TextView
                    android:id="@+id/btn_pip_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PiP"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/fpOnScrim"
                    android:maxLines="1" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="More"
                android:tooltipText="More">
                <ImageView
                    android:id="@+id/btn_more_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="?attr/fpOnScrim" />
                <TextView
                    android:id="@+id/btn_more_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="More"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/fpOnScrim"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="6dp">
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <LinearLayout
                android:id="@+id/btn_prev_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Prev"
                android:tooltipText="Prev">
                <ImageView
                    android:id="@+id/btn_prev_video_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="?attr/fpOnScrim" />
                <TextView
                    android:id="@+id/btn_prev_video_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prev"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/fpOnScrim"
                    android:maxLines="1" />
            </LinearLayout>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <LinearLayout
                android:id="@+id/btn_rew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back 10s"
                android:tooltipText="Back 10s">
                <ImageView
                    android:id="@+id/btn_rew_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_fast_rewind"
                    app:tint="?attr/fpOnScrim" />
                <TextView
                    android:id="@+id/btn_rew_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Back 10s"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/fpOnScrim"
                    android:maxLines="1" />
            </LinearLayout>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_play_circle">
                    <ImageButton
                        android:id="@+id/btn_play_video"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_pause"
                        android:contentDescription="Play or pause"
                        android:tooltipText="Play or pause"
                        android:padding="16dp"
                        app:tint="?attr/colorOnPrimary"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </FrameLayout>
                <TextView
                    android:id="@+id/tv_play_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pause"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/fpOnScrim" />
            </LinearLayout>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <LinearLayout
                android:id="@+id/btn_ff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Fwd 10s"
                android:tooltipText="Fwd 10s">
                <ImageView
                    android:id="@+id/btn_ff_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_fast_forward"
                    app:tint="?attr/fpOnScrim" />
                <TextView
                    android:id="@+id/btn_ff_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fwd 10s"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/fpOnScrim"
                    android:maxLines="1" />
            </LinearLayout>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <LinearLayout
                android:id="@+id/btn_next_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Next"
                android:tooltipText="Next">
                <ImageView
                    android:id="@+id/btn_next_video_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_skip_next"
                    app:tint="?attr/fpOnScrim" />
                <TextView
                    android:id="@+id/btn_next_video_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/fpOnScrim"
                    android:maxLines="1" />
            </LinearLayout>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">
            <TextView
                android:id="@+id/tv_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/fpOnScrim" />
            <SeekBar
                android:id="@+id/video_seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000" />
            <TextView
                android:id="@+id/tv_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/fpOnScrim" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="8dp"
            android:paddingBottom="8dp">
            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_lock"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lock"
                        android:textColor="?attr/fpOnScrim"
                        app:chipIcon="@drawable/ic_lock"
                        app:chipIconTint="?attr/fpOnScrim"
                        app:chipIconVisible="true"
                        app:chipStrokeColor="?attr/fpOnScrim" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_speed_video"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.0×"
                        android:textColor="?attr/fpOnScrim"
                        app:chipIcon="@drawable/ic_speed"
                        app:chipIconTint="?attr/fpOnScrim"
                        app:chipIconVisible="true"
                        app:chipStrokeColor="?attr/fpOnScrim" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_ratio"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fit"
                        android:textColor="?attr/fpOnScrim"
                        app:chipIcon="@drawable/ic_movie"
                        app:chipIconTint="?attr/fpOnScrim"
                        app:chipIconVisible="true"
                        app:chipStrokeColor="?attr/fpOnScrim" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_subtitle"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subtitles"
                        android:textColor="?attr/fpOnScrim"
                        app:chipIcon="@drawable/ic_subtitles"
                        app:chipIconTint="?attr/fpOnScrim"
                        app:chipIconVisible="true"
                        app:chipStrokeColor="?attr/fpOnScrim" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_audio_track"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audio"
                        android:textColor="?attr/fpOnScrim"
                        app:chipIcon="@drawable/ic_audiotrack"
                        app:chipIconTint="?attr/fpOnScrim"
                        app:chipIconVisible="true"
                        app:chipStrokeColor="?attr/fpOnScrim" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_sleep_video"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sleep"
                        android:textColor="?attr/fpOnScrim"
                        app:chipIcon="@drawable/ic_bedtime"
                        app:chipIconTint="?attr/fpOnScrim"
                        app:chipIconVisible="true"
                        app:chipStrokeColor="?attr/fpOnScrim" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Shown only while locked -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_unlock"
        style="@style/Widget.Material3.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="24dp"
        android:text="Unlock"
        android:visibility="gone"
        app:icon="@drawable/ic_lock_open" />

    <LinearLayout android:id="@+id/overlay_left"
        android:layout_width="84dp" android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical" android:layout_marginStart="24dp"
        android:gravity="center" android:orientation="vertical"
        android:background="@drawable/bg_badge"
        android:padding="10dp" android:visibility="invisible">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Brightness" android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/fpOnScrim" />
        <TextView android:id="@+id/tv_brightness_val"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="50%" android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/fpOnScrim" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/overlay_right"
        android:layout_width="84dp" android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical" android:layout_marginEnd="24dp"
        android:gravity="center" android:orientation="vertical"
        android:background="@drawable/bg_badge"
        android:padding="10dp" android:visibility="invisible">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Volume" android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/fpOnScrim" />
        <TextView android:id="@+id/tv_volume_val"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="50%" android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/fpOnScrim" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/tv_seek_indicator"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_badge"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/fpOnScrim" android:textStyle="bold"
        android:paddingHorizontal="20dp" android:paddingVertical="10dp"
        android:visibility="invisible" />

</FrameLayout>
